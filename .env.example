# NASA Earthdata Login (GEDI L4A) — https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google Earth Engine (Sentinel-2, canopy height, MapBiomas — server-side compositing/clipping)
# Register: https://signup.earthengine.google.com/ (noncommercial/academic track)
# Auth is interactive (`earthengine authenticate` / ee.Authenticate()), token stored in
# ~/.config/earthengine/, not here. Just need the Cloud project ID to initialize ee with.
EE_PROJECT_ID=

# Copernicus Data Space Ecosystem — deferred (2026-08-20: chose Path B, Google Earth Engine).
# Fallback only if GEE's noncommercial review takes too long.
# CDSE_USERNAME=
# CDSE_PASSWORD=
